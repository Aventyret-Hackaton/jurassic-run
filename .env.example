# Kopiera till .env.local (lokalt) och lägg samma värden i Vercel → Settings → Environment Variables.

# OpenRouteService – gratis nyckel: https://openrouteservice.org/dev/#/signup
# Utan nyckel används OSRM:s publika demoservrar (routing.openstreetmap.de) som reserv.
ORS_API_KEY=

# Claude API – valfritt. Utan nyckel används mallcoachen.
ANTHROPIC_API_KEY=
# Kolla exakt modell-ID på https://platform.claude.com/docs
CLAUDE_MODEL=claude-haiku-5-5

# Spotify-spellista som visas under löpningen – valfritt.
# Utan värde länkar appen till en Spotify-sökning på "extinct animals".
VITE_SPOTIFY_PLAYLIST_URL=
